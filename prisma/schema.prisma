generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Model {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  entries Entry[]

  @@map("models")
}

model Entry {
  id                   String   @id @default(cuid())
  name                 String
  phone                String   @unique
  phoneRaw             String
  customerLocation     String   @default("Unknown")
  interestedInPurchase String   @default("No")
  modelId              String?
  model                Model?   @relation(fields: [modelId], references: [id])
  ip                   String?
  userAgent            String?
  flag                 String?
  flagReason           String?
  excluded             Boolean  @default(false)
  createdAt            DateTime @default(now())
  winner               Winner?

  @@index([phone])
  @@index([ip])
  @@index([createdAt])
  @@index([phone, createdAt])
  @@index([ip, createdAt])
  @@index([excluded])
  @@map("entries")
}

model Winner {
  id        String   @id @default(cuid())
  entryId   String   @unique
  entry     Entry    @relation(fields: [entryId], references: [id])
  place     Int      @unique
  createdAt DateTime @default(now())

  @@map("winners")
}

model WhatsAppLog {
  id        String   @id @default(cuid())
  entryId   String
  status    String
  error     String?
  retries   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("whatsapp_logs")
}

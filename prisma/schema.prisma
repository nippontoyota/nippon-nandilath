generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  location  String?
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries    Entry[]
  winners    Winner[]
  drawStatus String   @default("PENDING")

  @@map("branches")
}

model Model {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  colours Colour[]
  entries Entry[]

  @@map("models")
}

model Colour {
  id      String  @id @default(cuid())
  name    String
  modelId String
  model   Model   @relation(fields: [modelId], references: [id])
  entries Entry[]

  @@unique([modelId, name])
  @@map("colours")
}

model Entry {
  id         String   @id @default(cuid())
  name       String
  phone      String   @unique
  phoneRaw   String
  modelId    String
  model      Model    @relation(fields: [modelId], references: [id])
  colourId   String
  colour     Colour   @relation(fields: [colourId], references: [id])
  vin        String   @unique
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  ip         String?
  userAgent  String?
  flag       String?
  flagReason String?
  excluded   Boolean  @default(false)
  createdAt  DateTime @default(now())
  winner     Winner?

  @@index([phone])
  @@index([vin])
  @@index([branchId])
  @@index([branchId, flag])
  @@index([branchId, excluded])
  @@index([ip])
  @@index([createdAt])
  @@index([phone, createdAt])
  @@index([ip, createdAt])
  @@map("entries")
}

model Winner {
  id        String   @id @default(cuid())
  entryId   String   @unique
  entry     Entry    @relation(fields: [entryId], references: [id])
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  place     Int
  createdAt DateTime @default(now())

  @@unique([branchId, place])
  @@index([branchId])
  @@map("winners")
}

model WhatsAppLog {
  id        String   @id @default(cuid())
  entryId   String
  status    String
  error     String?
  retries   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("whatsapp_logs")
}
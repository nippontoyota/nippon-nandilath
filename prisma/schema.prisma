generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Entry {
  id                   String   @id @default(cuid())
  name                 String
  phone                String   @unique
  phoneRaw             String
  email                String?
  customerLocation     String   @default("Unknown")
  ip                   String?
  userAgent            String?
  flag                 String?
  flagReason           String?
  excluded             Boolean  @default(false)
  createdAt            DateTime @default(now())
  callStatus           String?
  callOutcome          String?
  callRemark           String?

  call1Status          String?
  call1Outcome         String?
  call1Remark          String?
  
  call2Status          String?
  call2Outcome         String?
  call2Remark          String?
  
  call3Status          String?
  call3Outcome         String?
  call3Remark          String?
  
  call4Status          String?
  call4Outcome         String?
  call4Remark          String?
  
  call5Status          String?
  call5Outcome         String?
  call5Remark          String?
  winner               Winner?

  @@index([phone])
  @@index([ip])
  @@index([createdAt])
  @@index([phone, createdAt])
  @@index([ip, createdAt])
  @@index([excluded])
  @@index([callStatus])
  @@map("entries")
}

model Winner {
  id        String   @id @default(cuid())
  entryId   String   @unique
  entry     Entry    @relation(fields: [entryId], references: [id])
  place     Int      @unique
  createdAt DateTime @default(now())

  @@map("winners")
}

model WhatsAppLog {
  id        String   @id @default(cuid())
  entryId   String
  status    String
  error     String?
  retries   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("whatsapp_logs")
}
